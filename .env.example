# Copie para .env.local e preencha. O .env.local é ignorado pelo git.

# Obrigatória — a geração não funciona sem ela.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional. Sem ela a interface mostra os custos só em dólar, em vez de
# converter por uma cotação inventada que envelhece sozinha.
NEXT_PUBLIC_USD_BRL=5.42

# Opcional — liga os sinais de mercado curados do CRM, que substituem a busca
# paga na web. Sem elas a seção de sinais simplesmente não aparece.
#
# A RLS de market_signals exige usuário autenticado com acesso à empresa, então
# a leitura usa a service role key e acontece só no servidor.
#
# ATENÇÃO: a service role key IGNORA RLS. Ela nunca pode ganhar o prefixo
# NEXT_PUBLIC_ — no navegador daria a qualquer visitante o banco inteiro.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave de agente do gateway do CRM Sanwey, para enviar a peça pronta à fila de
# aprovação (agent_actions). O gateway vive no mesmo projeto de SUPABASE_URL, e a
# chave é que define qual agente assina a sugestão — o corpo do pedido não escolhe.
# Sem ela o botão "Enviar para aprovação" simplesmente não aparece.
CRM_AGENT_KEY=

# Opcional — busca de imagem no acervo do Unsplash. Sem ela a busca some da
# tela e sobra a biblioteca da frente. A ferramenta NUNCA gera imagem por IA:
# foto sintética de um produto real é uma afirmação visual feita por um modelo
# que nunca o viu (CLAUDE.md seção 2).
UNSPLASH_ACCESS_KEY=

# OBRIGATÓRIA fora de localhost — senha na frente do app (`src/proxy.ts`, Basic Auth).
#
# Em localhost / 127.0.0.1 continua opcional (npm run dev sem atrito). Em qualquer
# outra URL o proxy responde 503 sem ela: as rotas de API gastam a chave da
# Anthropic, leem sinais do CRM, escrevem na fila de aprovação e apagam arquivo
# da biblioteca. Quem souber o endereço faz tudo isso. Definir esta variável
# faz parte de "no ar".
# APP_PASSWORD=

# Opcional — encurtador próprio (rastreio Fase 3). Sem domínio estável
# definido pelo Daniel, deixe vazio: o QR usa a landing completa com UTM.
# Não inventar domínio. Ex.: https://go.exemplo.com.br
# NEXT_PUBLIC_SHORTENER_BASE=
