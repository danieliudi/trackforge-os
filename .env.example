# Copie para .env.local e preencha. O .env.local é ignorado pelo git.

# Obrigatória — a geração não funciona sem ela.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional. Sem ela a interface mostra os custos só em dólar, em vez de
# converter por uma cotação inventada que envelhece sozinha.
NEXT_PUBLIC_USD_BRL=5.42

# Opcional — liga os sinais de mercado curados do CRM, que substituem a busca
# paga na web. Sem elas a seção de sinais simplesmente não aparece.
#
# A RLS de market_signals exige usuário autenticado com acesso à empresa, então
# a leitura usa a service role key e acontece só no servidor.
#
# ATENÇÃO: a service role key IGNORA RLS. Ela nunca pode ganhar o prefixo
# NEXT_PUBLIC_ — no navegador daria a qualquer visitante o banco inteiro.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave de agente do gateway do CRM Sanwey, para enviar a peça pronta à fila de
# aprovação (agent_actions). O gateway vive no mesmo projeto de SUPABASE_URL, e a
# chave é que define qual agente assina a sugestão — o corpo do pedido não escolhe.
# Sem ela o botão "Enviar para aprovação" simplesmente não aparece.
CRM_AGENT_KEY=
